# Copie en .env et charge-le si tu veux changer ces valeurs.
# Toutes ont un défaut raisonnable pour un usage local.

JOBHUNT_DEBUG=1                 # 0 pour désactiver la page d'erreur détaillée
JOBHUNT_SECRET_KEY=change-moi   # obligatoire dès que l'app est exposée hors de localhost
JOBHUNT_AUTO_MIGRATE=1          # runserver génère et applique les migrations (défaut : suit DEBUG, sauf quand la base est distante)

# Base de données : une seule URL choisit le moteur. Sans rien, SQLite dans
# le dossier du projet (db.sqlite3). Trois écritures pour SQLite :
#   sqlite:///db.sqlite3          chemin relatif au dossier du projet (jamais au dossier courant)
#   sqlite:////var/lib/jobhunt/db.sqlite3   chemin absolu (quatre barres)
#   sqlite:///:memory:            base en mémoire, perdue à l'arrêt
# PostgreSQL (Azure Database for PostgreSQL, par exemple) :
#   postgres://utilisateur:motdepasse@monserveur.postgres.database.azure.com:5432/jobhunt?sslmode=require
# Dans le mot de passe, encode @ : / # % en %40 %3A %2F %23 %25. Hôte distant
# sans sslmode → sslmode=require d'office. Les autres paramètres de la requête
# (sslrootcert, connect_timeout, options, target_session_attrs…) passent tels
# quels à libpq. ?pool=1 ouvre un pool de connexions côté application (il faut
# psycopg[pool] : voir « Base de données » dans le README).
JOBHUNT_DATABASE_URL=sqlite:///db.sqlite3
JOBHUNT_DB_CONN_MAX_AGE=60      # PostgreSQL : durée de vie d'une connexion en secondes (0 : une par requête, none : illimitée ; forcé à 0 avec ?pool=1)

# Comptes. « local » : un profil sans mot de passe, créé à la première visite
# (défaut quand JOBHUNT_DEBUG=1). « accounts » : connexion et inscription
# (défaut quand JOBHUNT_DEBUG=0).
JOBHUNT_AUTH_MODE=local
JOBHUNT_SIGNUP_OPEN=1           # mode accounts : 0 pour fermer les inscriptions
JOBHUNT_ALLOWED_HOSTS=localhost,127.0.0.1           # hôtes servis, séparés par des virgules
JOBHUNT_CSRF_TRUSTED_ORIGINS=http://localhost:8000  # origines acceptées pour les formulaires
JOBHUNT_SECURE_COOKIES=0        # 1 derrière HTTPS (défaut en mode accounts hors DEBUG)

# Valeurs proposées à un nouveau profil ; chacun règle ensuite les siennes
# dans Réglages.
JOBHUNT_STALE_AFTER_DAYS=14     # au-delà, une candidature envoyée est signalée
JOBHUNT_FOLLOW_UP_DAYS=10       # délai proposé pour la relance après un envoi
JOBHUNT_SEARCH_RADIUS_KM=40     # rayon de recherche autour du point de départ

# Isolation des données (PostgreSQL seulement, voir « Isolation des données »
# dans le README). Les migrations créent le rôle applicatif et lui donnent les
# tables ; c'est avec lui que le serveur web se connecte (JOBHUNT_DATABASE_URL),
# les migrations tournant avec le rôle propriétaire (l'admin Azure).
JOBHUNT_DB_APP_ROLE=jobhunt_app
JOBHUNT_RLS_ENFORCE=1           # refuse de servir si les politiques ne sont pas en vigueur (défaut : 1 en mode accounts hors DEBUG)

# Fichiers téléversés (CV, annonces). « local » : dans media/ du projet,
# jamais servis par leur chemin — chaque téléchargement passe par une vue qui
# vérifie le propriétaire (défaut). « azure » : un conteneur Azure Blob
# Storage, le téléchargement redirigeant vers une URL SAS en lecture seule
# valable JOBHUNT_STORAGE_LINK_TTL secondes. « memory » : en mémoire, perdus
# à l'arrêt (tests). Voir « Stockage des fichiers » dans le README.
JOBHUNT_STORAGE_PROVIDER=local
JOBHUNT_STORAGE_LINK_TTL=300    # validité d'un lien de téléchargement, en secondes (1 à 3600)

# Azure : trois façons de s'authentifier, de la plus recommandée à la plus
# pratique. (1) l'URL du compte seule — c'est l'identité managée du service
# qui signe (rôles « Storage Blob Data Contributor » et « Storage Blob
# Delegator », plus AZURE_CLIENT_ID pour une identité affectée) ; (2) l'URL
# et la clé, via une référence Key Vault sur App Service ; (3) la chaîne de
# connexion, pour le développement et Azurite (elle est décomposée au
# démarrage : seule la clé arrive dans les réglages, où Django la masque).
# Le pilote s'installe avec « uv sync --extra azure ».
#JOBHUNT_AZURE_STORAGE_ACCOUNT_URL=https://moncompte.blob.core.windows.net
#JOBHUNT_AZURE_STORAGE_ACCOUNT_KEY=…
#JOBHUNT_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=moncompte;AccountKey=…;EndpointSuffix=core.windows.net
#JOBHUNT_AZURE_STORAGE_CONTAINER=documents   # doit exister ; minuscules, chiffres, tirets
# Le SDK attend une minute avant d'abandonner ; une page ne peut pas.
#JOBHUNT_AZURE_STORAGE_RETRY_TOTAL=1
#JOBHUNT_AZURE_STORAGE_CONNECTION_TIMEOUT=3
#JOBHUNT_AZURE_STORAGE_READ_TIMEOUT=30
#JOBHUNT_AZURE_STORAGE_INITIAL_BACKOFF=1

# Copilote IA (l'app jobhunt_ai, livrée avec le cœur et activée par défaut).
# 0 pour s'en passer : ses pages (/copilote/), sa navigation et sa file de
# tâches disparaissent ensemble. L'analyse de CV est gratuite ; les autres
# fonctions dépendent de l'accès Premium (Profile.premium_until).
# Ses agents tournent dans « manage.py qcluster ».
COPILOT_ENABLED=1
# Fournisseur indépendant des droits Premium et du mode SaaS.
# Une clé OpenAI seule ne sélectionne pas le fournisseur : active aussi la
# ligne suivante. Relance le serveur web et qcluster après modification.
#JOBHUNT_AI_PROVIDER=openai
#JOBHUNT_AI_OPENAI_API_KEY=…     # OPENAI_API_KEY aussi accepté ; Key Vault en hébergement Azure
#JOBHUNT_AI_OPENAI_SIMPLE_MODEL=gpt-4o-mini-2024-07-18
#JOBHUNT_AI_OPENAI_COMPLEX_MODEL=gpt-4o-2024-08-06
#JOBHUNT_AI_API_KEY=…           # clé du fournisseur (Anthropic) ; ANTHROPIC_API_KEY est aussi acceptée
#JOBHUNT_AI_MODEL=claude-opus-5     # modèle utilisé par les agents (défaut dans jobhunt_ai/settings.py)
#JOBHUNT_AI_LOCATION="Nivelles, Belgique"  # point de départ proposé à l'éclaireur quand le profil n'en a pas
#JOBHUNT_AI_RADIUS_KM=40         # rayon proposé à l'éclaireur (défaut : les préférences du profil)
#BRIGHTDATA_API_TOKEN=           # jeton Bright Data pour la recherche d'offres (JOBHUNT_AI_BRIGHTDATA_API_TOKEN aussi accepté)
# File de tâches django_q (voir docs/async-tasks.md).
JOBHUNT_Q_WORKERS=2             # processus du cluster
JOBHUNT_Q_TIMEOUT=1800          # durée maximale d'une tâche, en secondes
#JOBHUNT_Q_RETRY=5520            # délai avant de représenter une tâche sans accusé (défaut : 3 × timeout + 120)
# Offre commerciale hébergée : accès gratuit/payant et quotas par compte.
# Indépendant du fournisseur (voir docs/azure-saas.md).
#IS_SAAS_PRODUCTION=true
#JOBHUNT_AI_PROVIDER=azure_openai # seulement après provisionnement et quota Azure
#JOBHUNT_AI_AZURE_ENDPOINT=https://monressource.openai.azure.com
#JOBHUNT_AI_AZURE_API_KEY=…
#JOBHUNT_AI_AZURE_API_VERSION=2024-10-21
#JOBHUNT_AI_AZURE_SIMPLE_DEPLOYMENT=gpt-4o-mini
#JOBHUNT_AI_AZURE_COMPLEX_DEPLOYMENT=gpt-4o
#JOBHUNT_AI_UPGRADE_URL=https://tonjobideal.com/premium
